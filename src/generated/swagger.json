					"name": {
						"type": "string"
					},
					"password": {
						"type": "string"
					},
					"roleId": {
						"type": "string"
					}
				},
				"required": [
					"email",
					"name",
					"password"
				],
				"type": "object",
				"additionalProperties": false
			},
			"LoginRequest": {
