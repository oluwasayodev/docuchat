generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProviderType {
  LOCAL
  GOOGLE
  COGNITO
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String?
  roles         UserRole[]
  identities    UserIdentity[]
  refreshTokens RefreshToken[]
  tier          String         @default("free")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@map("users")
}

model ChatDocument {
  id          String    @id @default(uuid())
  name        String
  description String
  pages       Int
  fileUrl     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("chat_documents")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  action    String           @unique
  resource  String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("refresh_tokens")
}

model UserIdentity {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProviderType
  providerId String
  createdAt  DateTime         @default(now())

  @@unique([provider, providerId])
  @@map("user_identities")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], onDelete: Cascade, references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}
